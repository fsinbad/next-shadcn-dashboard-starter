generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String    @id
  dingtalk_union_id String    @unique
  name              String?
  email             String?
  avatar_url        String?
  created_at        Int
  updated_at        Int

  memberships       Membership[]
  sessions          Session[]

  @@index([dingtalk_union_id])
  @@map("users")
}

model Organization {
  id         String   @id
  name       String
  slug       String   @unique
  logo_url   String?
  created_at Int
  updated_at Int

  memberships Membership[]

  @@map("organizations")
}

model Membership {
  id         String   @id
  user_id    String
  org_id     String
  role       String   @default("member")
  created_at Int
  updated_at Int

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([user_id, org_id])
  @@index([user_id])
  @@index([org_id])
  @@map("memberships")
}

model Session {
  id         String   @id
  user_id    String
  token      String   @unique
  expires_at Int
  created_at Int

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expires_at])
  @@map("sessions")
}
